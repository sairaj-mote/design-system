{
  "name": "RanchiMall Design System",
  "version": "1.0.0",
  "author": "Sairaj Mote",
  "updated": "2026-10-01",
  "source": "This file is the single source of truth for design tokens. CSS custom properties are generated from it (see tokens/tokens.css).",
  "color": {
    "brand": {
      "primary": {
        "50": { "hex": "#e6f6f6" },
        "100": { "hex": "#c4e9e9" },
        "200": { "hex": "#9ad9da" },
        "300": { "hex": "#6cc8c9" },
        "400": { "hex": "#45bbbb" },
        "500": { "hex": "#24a7a9" },
        "600": { "hex": "#0d7377", "role": "brand base · light-mode accent" },
        "700": { "hex": "#0b6165" },
        "800": { "hex": "#094e51" },
        "900": { "hex": "#073b3e" }
      },
      "secondary": {
        "50": { "hex": "#fff8e8" },
        "100": { "hex": "#ffecc0" },
        "200": { "hex": "#ffdc8d" },
        "300": { "hex": "#ffcc5c" },
        "400": { "hex": "#ffbe38" },
        "500": { "hex": "#ffac2e", "role": "brand base" },
        "600": { "hex": "#e08f14" },
        "700": { "hex": "#b8730e" },
        "800": { "hex": "#8f580b" },
        "900": { "hex": "#663e07" }
      }
    },
    "neutral": {
      "0": { "hex": "#ffffff", "role": "pure white" },
      "50": { "hex": "#fafbfc" },
      "100": { "hex": "#f1f3f8", "role": "light background" },
      "200": { "hex": "#e6e9ef" },
      "300": { "hex": "#cdd2dc" },
      "400": { "hex": "#9aa1af" },
      "500": { "hex": "#6b7280" },
      "600": { "hex": "#4b5261" },
      "700": { "hex": "#333a47" },
      "800": { "hex": "#1d2129" },
      "900": { "hex": "#151616", "role": "dark background" }
    },
    "semantic": {
      "success": {
        "light": "#1cad59",
        "dark": "#00e676",
        "role": "positive / confirm states"
      },
      "warning": {
        "light": "#dca500",
        "dark": "#ffd505",
        "role": "caution / pending states"
      },
      "danger": {
        "light": "#ff4b4b",
        "dark": "#ff6a6a",
        "role": "errors / destructive actions"
      },
      "info": {
        "light": "#0d7377",
        "dark": "#32e0c4",
        "role": "information / neutral feedback"
      }
    },
    "theme": {
      "text": { "light": "#141414", "dark": "#dcdcdc", "role": "default text" },
      "foreground": {
        "light": "#fcfdff",
        "dark": "#1b1c1d",
        "role": "surface / elevated backgrounds"
      },
      "background": {
        "light": "#f1f3f8",
        "dark": "#151616",
        "role": "page background"
      },
      "accent": {
        "light": "#0d7377",
        "dark": "#32e0c4",
        "role": "active / interactive states"
      },
      "secondary": {
        "light": "#ffac2e",
        "dark": "#d60739",
        "role": "highlight / attention"
      },
      "danger": {
        "light": "#ff4b4b",
        "dark": "#ff6a6a",
        "role": "errors / destructive actions"
      }
    }
  },
  "typography": {
    "families": {
      "display": {
        "stack": "\"Poppins\", sans-serif",
        "usage": "Headings, display text, brand moments"
      },
      "body": {
        "stack": "\"Roboto\", sans-serif",
        "usage": "Body copy, UI text, long-form content"
      },
      "mono": {
        "stack": "\"Roboto Mono\", monospace",
        "usage": "Code, numbers, data, tokens"
      }
    },
    "weights": [400, 500, 600, 700],
    "scale": [
      {
        "name": "display",
        "size": "clamp(2.5rem, 5vw, 3.5rem)",
        "weight": 700,
        "lineHeight": 1.15,
        "family": "display"
      },
      {
        "name": "h1",
        "size": "2.5rem",
        "weight": 700,
        "lineHeight": 1.2,
        "family": "display"
      },
      {
        "name": "h2",
        "size": "2rem",
        "weight": 700,
        "lineHeight": 1.25,
        "family": "display"
      },
      {
        "name": "h3",
        "size": "1.4rem",
        "weight": 600,
        "lineHeight": 1.3,
        "family": "display"
      },
      {
        "name": "h4",
        "size": "1rem",
        "weight": 600,
        "lineHeight": 1.4,
        "family": "display"
      },
      {
        "name": "h5",
        "size": "0.8rem",
        "weight": 500,
        "lineHeight": 1.5,
        "family": "display",
        "transform": "uppercase",
        "tracking": "0.08em"
      },
      {
        "name": "body",
        "size": "0.9rem",
        "weight": 400,
        "lineHeight": 1.7,
        "family": "body"
      },
      {
        "name": "small",
        "size": "0.75rem",
        "weight": 400,
        "lineHeight": 1.6,
        "family": "body"
      },
      {
        "name": "mono",
        "size": "0.875rem",
        "weight": 400,
        "lineHeight": 1.6,
        "family": "mono"
      }
    ]
  },
  "spacing": {
    "unit": "0.25rem (4px)",
    "scale": [
      {
        "name": "space-1",
        "rem": "0.25rem",
        "px": 4,
        "usage": "tight grouping, icon gaps"
      },
      {
        "name": "space-2",
        "rem": "0.5rem",
        "px": 8,
        "usage": "component internal padding"
      },
      {
        "name": "space-3",
        "rem": "0.75rem",
        "px": 12,
        "usage": "compact list / form gaps"
      },
      {
        "name": "space-4",
        "rem": "1rem",
        "px": 16,
        "usage": "default gutters, card padding"
      },
      {
        "name": "space-5",
        "rem": "1.5rem",
        "px": 24,
        "usage": "section spacing, popup padding"
      },
      {
        "name": "space-6",
        "rem": "2rem",
        "px": 32,
        "usage": "large card / panel gaps"
      },
      { "name": "space-7", "rem": "3rem", "px": 48, "usage": "section rhythm" },
      {
        "name": "space-8",
        "rem": "4rem",
        "px": 64,
        "usage": "page-level rhythm"
      },
      {
        "name": "space-9",
        "rem": "6rem",
        "px": 96,
        "usage": "hero / landing spacing"
      }
    ]
  },
  "radius": {
    "sm": { "value": "0.2rem", "usage": "chips, tags, small highlights" },
    "md": {
      "value": "0.3rem",
      "usage": "default component radius (buttons, inputs)"
    },
    "lg": { "value": "0.4rem", "usage": "cards, popups, larger surfaces" },
    "full": { "value": "9999px", "usage": "pills, avatars, toggle handles" }
  },
  "shadow": {
    "sm": {
      "value": "0 1px 2px rgba(20,20,20,0.06)",
      "usage": "subtle separation, cards"
    },
    "md": {
      "value": "0 2px 8px rgba(20,20,20,0.12)",
      "usage": "popups, floating action elements"
    },
    "lg": {
      "value": "0 8px 24px rgba(20,20,20,0.16)",
      "usage": "modals, dropdown menus, elevated surfaces"
    }
  },
  "motion": {
    "duration": {
      "fast": { "ms": 100, "usage": "micro-interactions, hovers, ripples" },
      "base": { "ms": 150, "usage": "default UI transitions" },
      "slow": {
        "ms": 300,
        "usage": "page changes, popup show/hide, view transitions"
      }
    },
    "easing": {
      "linear": "linear",
      "ease": "ease",
      "ease-out": "ease-out",
      "spring": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
    }
  },
  "breakpoints": {
    "mobile": {
      "min": "0px",
      "max": "639px",
      "usage": "phones, single column"
    },
    "tablet": {
      "min": "640px",
      "max": "1023px",
      "usage": "foldables, small tablets"
    },
    "desktop": { "min": "1024px", "max": null, "usage": "laptops & desktops" }
  },
  "zIndex": {
    "base": 1,
    "header": 10,
    "popupStack": 50,
    "notification": 100
  },
  "icon": {
    "grid": "24 × 24px",
    "strokeWeight": "1.5px",
    "sizes": ["sm: 16px", "md: 24px", "lg: 32px"]
  }
}
